{
  "name": "dodo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:emulator": "firebase emulators:exec --only firestore,auth,storage --project demo-dodo 'pnpm -r test'",
    "emulators": "firebase emulators:start --only auth,firestore,storage,functions --project demo-dodo",
    "seed": "node scripts/seed-emulator.mjs",
    "dev": "pnpm --filter @dodo/core build && pnpm --filter @dodo/web dev:emulators",
    "test:e2e": "firebase emulators:exec --only auth,firestore,storage,functions --project demo-dodo 'node scripts/e2e-emulator.mjs'",
    "dodo": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "firebase-tools": "^15.34.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "firebase-admin": "^13.5.0"
  }
}
