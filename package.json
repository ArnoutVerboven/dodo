{
  "name": "dodo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:emulator": "firebase emulators:exec --only firestore,auth,storage --project demo-dodo 'pnpm -r --filter=!@dodo/web test'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "firebase-tools": "^15.34.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
