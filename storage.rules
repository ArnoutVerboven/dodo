rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /tasks/{taskId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.dodo_owner == true;
      allow create, update: if request.auth != null && request.auth.token.dodo_owner == true
        && request.resource.size < 25 * 1024 * 1024;
      // A delete has no request.resource, so it needs its own rule.
      allow delete: if request.auth != null && request.auth.token.dodo_owner == true;
    }
    // Archived sessions and traces: written by the control plane, readable by the owner.
    match /runs/{runId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.dodo_owner == true;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
