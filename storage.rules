rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /tasks/{taskId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.dodo_owner == true;
      allow write: if request.auth != null && request.auth.token.dodo_owner == true
        && request.resource.size < 25 * 1024 * 1024;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
