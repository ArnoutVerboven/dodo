rules_version = '2';

// Three identities:
//  - the owner (custom claim dodo_owner, granted by the claimOwnership function);
//  - a run (uid run:{runId}, claims run/taskId/generation, minted by the dispatcher): may only
//    write its own trace, and its task's summary/status/messages/artifacts, while its lease
//    generation is current;
//  - a Mac daemon (uid device:{id}, claim device, minted by deviceRegister): may read the queued
//    runs addressed to it and report presence on its own device document, nothing else;
//  - trusted server code (Admin SDK, bypasses rules): budgets, ledger, run state.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.dodo_owner == true;
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function runDoc(runId) {
      return get(/databases/$(database)/documents/runs/$(runId)).data;
    }
    // A run identity whose lease generation still matches the run document.
    function isLiveRun(runId) {
      return request.auth != null
        && request.auth.uid == 'run:' + runId
        && request.auth.token.run == runId
        && request.auth.token.generation == runDoc(runId).generation
        && runDoc(runId).state in ['claimed', 'running'];
    }
    function isDevice(deviceId) {
      return request.auth != null
        && request.auth.uid == 'device:' + deviceId
        && request.auth.token.device == deviceId;
    }
    function isApprovedDevice(deviceId) {
      return isDevice(deviceId)
        && get(/databases/$(database)/documents/devices/$(deviceId)).data.state == 'approved';
    }
    function isRunOnTask(taskId) {
      return request.auth != null
        && request.auth.token.run is string
        && request.auth.token.taskId == taskId
        && isLiveRun(request.auth.token.run);
    }

    match /settings/global {
      allow read, write: if isOwner();
    }

    match /projects/{projectId} {
      allow read: if isOwner() || (request.auth != null && request.auth.token.run is string && isLiveRun(request.auth.token.run));
      allow write: if isOwner();
    }

    match /tasks/{taskId} {
      allow read, write: if isOwner();
      allow read: if isRunOnTask(taskId);
      // The agent keeps the top-down Summary and Status; nothing else on the task.
      allow update: if isRunOnTask(taskId) && onlyChanges(['summary', 'statusLine', 'updatedAt']);

      match /messages/{messageId} {
        allow read: if isOwner() || isRunOnTask(taskId);
        // The owner writes only their own messages and answers to input requests.
        allow create: if isOwner() && request.resource.data.author == 'user';
        allow update: if isOwner() && onlyChanges(['input']);
        // The agent posts plain messages; input requests go through the control plane.
        allow create: if isRunOnTask(taskId)
          && request.resource.data.author == 'agent'
          && request.resource.data.runId == request.auth.token.run
          && !('input' in request.resource.data);
      }
      match /artifacts/{artifactId} {
        allow read, write: if isOwner();
        allow read: if isRunOnTask(taskId);
        allow create: if isRunOnTask(taskId) && request.resource.data.createdBy == 'agent';
      }
    }

    match /devices/{deviceId} {
      allow read, write: if isOwner();
      allow read: if isDevice(deviceId);
      // The daemon reports presence and its folders on its own document; the owner decides the rest.
      allow update: if isDevice(deviceId)
        && resource.data.state == 'approved'
        && onlyChanges(['lastSeen', 'version', 'protocol', 'folders', 'currentRunId', 'updatedAt']);
    }

    match /runs/{runId} {
      allow read: if isOwner() || isLiveRun(runId);
      // A Mac sees the runs addressed to it, so it knows when to claim one.
      allow read: if request.auth != null
        && request.auth.token.device is string
        && resource.data.device == 'mac:' + request.auth.token.device
        && isApprovedDevice(request.auth.token.device);
      // The owner can only request an interrupt.
      allow update: if isOwner() && onlyChanges(['interrupt']) && request.resource.data.interrupt == true;
      match /events/{eventId} {
        allow read: if isOwner() || isLiveRun(runId);
        allow create: if isLiveRun(runId) && request.resource.data.runId == runId;
      }
    }

    // Web push registrations of the owner's browsers. Runs never see them.
    match /pushTokens/{token} {
      allow read, write: if isOwner();
    }

    match /budgets/{scope} {
      allow read: if isOwner();
    }
    match /ledger/{entryId} {
      allow read: if isOwner();
    }
    match /reservations/{id} {
      allow read: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
