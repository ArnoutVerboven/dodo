rules_version = '2';

// Three identities:
//  - the owner (custom claim dodo_owner, granted by the claimOwnership function);
//  - a run (uid run:{runId}, claims run/taskId/generation, minted by the dispatcher): may only
//    write its own trace, and its task's summary/status/messages/artifacts, while its lease
//    generation is current;
//  - a Mac daemon (uid device:{id}, claim device, minted by deviceRegister): may read the queued
//    runs addressed to it and report presence on its own device document, nothing else;
//  - trusted server code (Admin SDK, bypasses rules): budgets, ledger, run state.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.dodo_owner == true;
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function runDoc(runId) {
      return get(/databases/$(database)/documents/runs/$(runId)).data;
    }
    // A run identity whose lease generation still matches the run document.
    function isLiveRun(runId) {
      return request.auth != null
        && request.auth.uid == 'run:' + runId
        && request.auth.token.run == runId
        && request.auth.token.generation == runDoc(runId).generation
        && runDoc(runId).state in ['claimed', 'running'];
    }
    function isDevice(deviceId) {
      return request.auth != null
        && request.auth.uid == 'device:' + deviceId
        && request.auth.token.device == deviceId;
    }
    function isApprovedDevice(deviceId) {
      return isDevice(deviceId)
        && get(/databases/$(database)/documents/devices/$(deviceId)).data.state == 'approved';
    }
    function isRunOnTask(taskId) {
      return request.auth != null
        && request.auth.token.run is string
        && request.auth.token.taskId == taskId
        && isLiveRun(request.auth.token.run);
    }

    match /settings/global {
      allow read, write: if isOwner();
    }

    // Personal info: not secret, so the agent of any live run may read it.
    match /settings/profile {
      allow read, write: if isOwner();
      allow read: if request.auth != null && request.auth.token.run is string && isLiveRun(request.auth.token.run);
    }

    // Tools view: built-ins turned off globally. Runs get their tools through runStart.
    match /settings/tools {
      allow read, write: if isOwner();
    }

    // MCP servers. Remote ones are added through mcpServerSave (their header is in Secret
    // Manager); the owner toggles servers and tools here. A Mac lists the local servers it
    // runs (`dodo mcp add`) on documents it owns, and writes their tool lists; whether a
    // server and its tools are on stays the owner's call.
    match /mcpServers/{serverId} {
      allow read, write: if isOwner();
      allow read: if request.auth != null
        && request.auth.token.device is string
        && resource.data.deviceId == request.auth.token.device
        && isApprovedDevice(request.auth.token.device);
      allow create: if request.auth != null
        && request.auth.token.device is string
        && isApprovedDevice(request.auth.token.device)
        && request.resource.data.deviceId == request.auth.token.device
        && request.resource.data.runsOn == 'local'
        && serverId == request.auth.token.device + '-' + request.resource.data.slug
        && request.resource.data.keys().hasOnly(['name', 'slug', 'runsOn', 'transport', 'url', 'command', 'args', 'deviceId', 'enabled', 'disabledTools', 'catalog', 'error', 'createdAt', 'updatedAt']);
      allow update: if request.auth != null
        && request.auth.token.device is string
        && isApprovedDevice(request.auth.token.device)
        && resource.data.deviceId == request.auth.token.device
        && onlyChanges(['name', 'transport', 'url', 'command', 'args', 'catalog', 'error', 'updatedAt']);
      allow delete: if request.auth != null
        && request.auth.token.device is string
        && isApprovedDevice(request.auth.token.device)
        && resource.data.deviceId == request.auth.token.device;
    }

    // Toolsets: presets of tools the owner attaches to tasks and projects.
    match /toolsets/{toolsetId} {
      allow read, write: if isOwner();
    }

    // Vault entries hold names, sites and field names only; values are in Secret Manager and
    // reach a run one at a time through vaultResolve. Writes go through vaultSave/vaultDelete.
    match /vault/{entryId} {
      allow read: if isOwner();
      allow read: if request.auth != null && request.auth.token.run is string && isLiveRun(request.auth.token.run);
    }

    // GitHub App connection: app name, installation, repo list. Written by the GitHub functions;
    // the app's private key is in Secret Manager (dodo-github-app), never here.
    match /github/{docId} {
      allow read: if isOwner();
    }

    match /projects/{projectId} {
      allow read: if isOwner() || (request.auth != null && request.auth.token.run is string && isLiveRun(request.auth.token.run));
      allow write: if isOwner();
    }

    match /tasks/{taskId} {
      allow read, write: if isOwner();
      allow read: if isRunOnTask(taskId);
      // The agent keeps the top-down Summary and Status; nothing else on the task.
      allow update: if isRunOnTask(taskId) && onlyChanges(['summary', 'statusLine', 'updatedAt']);

      match /messages/{messageId} {
        allow read: if isOwner() || isRunOnTask(taskId);
        // The owner writes only their own messages and answers to input requests.
        allow create: if isOwner() && request.resource.data.author == 'user';
        allow update: if isOwner() && onlyChanges(['input']);
        // The agent posts plain messages; input requests go through the control plane.
        allow create: if isRunOnTask(taskId)
          && request.resource.data.author == 'agent'
          && request.resource.data.runId == request.auth.token.run
          && !('input' in request.resource.data);
      }
      match /artifacts/{artifactId} {
        allow read, write: if isOwner();
        allow read: if isRunOnTask(taskId);
        allow create: if isRunOnTask(taskId) && request.resource.data.createdBy == 'agent';
      }
    }

    match /devices/{deviceId} {
      allow read, write: if isOwner();
      allow read: if isDevice(deviceId);
      // The daemon reports presence and its folders on its own document; the owner decides the rest.
      allow update: if isDevice(deviceId)
        && resource.data.state == 'approved'
        && onlyChanges(['lastSeen', 'version', 'protocol', 'folders', 'browser', 'currentRunId', 'updatedAt']);
    }

    match /runs/{runId} {
      allow read: if isOwner() || isLiveRun(runId);
      // A Mac sees the runs addressed to it, so it knows when to claim one.
      allow read: if request.auth != null
        && request.auth.token.device is string
        && resource.data.device == 'mac:' + request.auth.token.device
        && isApprovedDevice(request.auth.token.device);
      // The owner can only request an interrupt.
      allow update: if isOwner() && onlyChanges(['interrupt']) && request.resource.data.interrupt == true;
      match /events/{eventId} {
        allow read: if isOwner() || isLiveRun(runId);
        allow create: if isLiveRun(runId) && request.resource.data.runId == runId;
      }
    }

    // Web push registrations of the owner's browsers. Runs never see them.
    match /pushTokens/{token} {
      allow read, write: if isOwner();
    }

    // Task API tokens: created by the apiTokenCreate function (hash only); the owner can list,
    // revoke and delete them. Idempotency keys (ingestKeys) are server-only.
    match /apiTokens/{id} {
      allow read, delete: if isOwner();
      allow update: if isOwner() && onlyChanges(['revoked']) && request.resource.data.revoked == true;
    }

    // Jobs (docs/JOBS.md). The owner turns jobs on and off and edits their config; state,
    // ledgers, runs and connector status are written by the Jobs functions only. Tokens and
    // OAuth states (connectorSecrets, oauthStates) are server-only.
    match /jobs/{jobId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['kind', 'enabled', 'config', 'createdAt', 'updatedAt'])
        && request.resource.data.kind in ['gmail-followup', 'whatsapp-followup'];
      allow update: if isOwner() && onlyChanges(['enabled', 'config', 'updatedAt']);
      match /{sub=**} {
        allow read: if isOwner();
      }
    }
    match /jobRuns/{runId} {
      allow read: if isOwner();
    }
    match /connectors/{id} {
      allow read: if isOwner();
    }

    match /budgets/{scope} {
      allow read: if isOwner();
    }
    match /ledger/{entryId} {
      allow read: if isOwner();
    }
    match /reservations/{id} {
      allow read: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
