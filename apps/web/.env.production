# Firebase web config. Not secret: Firebase web API keys identify the project, and access
# is controlled by Auth + security rules. Restrict the key to the app's domains in GCP.
VITE_FIREBASE_API_KEY=AIzaSyAvXlQiPRQh44taEaooHlgmn-sqVLcrg6U
# Same domain as Firebase Hosting, so the sign-in helper (/__/auth/handler) is first-party.
# With firebaseapp.com, storage-partitioned browsers lose its state ("missing initial state").
# Requires https://dodo-app.web.app/__/auth/handler in the OAuth client's redirect URIs.
VITE_FIREBASE_AUTH_DOMAIN=dodo-app.web.app
VITE_FIREBASE_PROJECT_ID=dodo-512722
VITE_FIREBASE_STORAGE_BUCKET=dodo-512722.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=496498787819
VITE_FIREBASE_APP_ID=1:496498787819:web:e955219bec12c49d5105ae
