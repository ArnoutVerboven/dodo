# Copy to .env.local. Values come from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=dodo-512722.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dodo-512722
VITE_FIREBASE_STORAGE_BUCKET=dodo-512722.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: Web Push certificate public key (Firebase console › Cloud Messaging). Empty uses the SDK default.
VITE_FIREBASE_VAPID_KEY=
# true = use local Firebase emulators (pnpm emulators) instead of the real project
VITE_USE_EMULATORS=false
